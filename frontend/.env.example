# Strapi CMS connection
# Server-side only (no NEXT_PUBLIC_ prefix — keeps the API token secret!)
STRAPI_URL=http://localhost:1337

# You must generate a Read-Only API Token in the Strapi Admin (Settings -> API Tokens)
# and paste it here:
STRAPI_API_TOKEN=your_strapi_api_token_here

# Used by next.config.ts for next/image remotePatterns to allow loading Strapi media
STRAPI_HOST=localhost
STRAPI_PORT=1337
