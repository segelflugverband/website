{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global",
    "description": "Site-wide settings: header navigation, footer, logo, copyright, and social links"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "headerNav": {
      "type": "component",
      "repeatable": true,
      "component": "shared.nav-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "footerColumns": {
      "type": "component",
      "repeatable": true,
      "component": "shared.footer-column",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "copyright": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
