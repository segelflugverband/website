{
  "collectionName": "components_shared_nav_items",
  "info": {
    "displayName": "Nav Item",
    "icon": "bulletList",
    "description": "A top-level navigation item in the header (optionally with a submenu)"
  },
  "options": {},
  "attributes": {
    "text": {
      "type": "string",
      "required": true
    },
    "href": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imageAlt": {
      "type": "string"
    },
    "submenu": {
      "type": "component",
      "repeatable": true,
      "component": "shared.submenu-item"
    }
  }
}
